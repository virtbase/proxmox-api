{
  "name": "proxmox-api-monorepo",
  "type": "module",
  "private": true,
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/virtbase/proxmox-api"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.1",
  "workspaces": [
    "docs",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "codegen": "turbo run codegen",
    "codegen:check": "turbo run codegen:check",
    "dev": "turbo watch dev --continue",
    "docs:build": "turbo -F @virtbase/proxmox-api-docs build",
    "docs:dev": "turbo -F @virtbase/proxmox-api-docs dev",
    "docs:preview": "turbo -F @virtbase/proxmox-api-docs preview",
    "prepare": "husky",
    "test": "turbo run test",
    "test:coverage": "turbo run test --force -- --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "turbo run typecheck"
  },
  "catalog": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
