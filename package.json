{
  "name": "proxmox-api-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtbase/proxmox-api.git"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "docs",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:ci": "biome ci --error-on-warnings .",
    "check:write": "biome check --write .",
    "clean": "git clean -xdf .turbo node_modules",
    "clean:workspaces": "turbo run clean",
    "codegen": "turbo run codegen",
    "codegen:check": "turbo run codegen:check",
    "codegen:update": "turbo run codegen:update",
    "docs:build": "turbo run build --filter=@virtbase/proxmox-api-docs",
    "docs:dev": "turbo run dev --filter=@virtbase/proxmox-api-docs",
    "lint:docs": "bun scripts/check-doc-comments.ts",
    "lint:knip": "knip-bun",
    "lint:publint": "turbo run publint",
    "lint:sherif": "bun --bun sherif --fail-on-warnings",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "verify": "bun run check:ci && bun run typecheck && turbo run test build publint codegen:check && bun run lint:docs && bun run lint:knip && bun run lint:sherif"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "sherif": "1.13.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [],
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "source-map-js": "1.2.2"
  }
}
