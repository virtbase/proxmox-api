{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["GITHUB_ACTIONS", "GITHUB_OUTPUT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "publint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "codegen": {
      "cache": false
    },
    "codegen:check": {
      "cache": false
    },
    "codegen:update": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
