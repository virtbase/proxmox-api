{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "//#check": {},
    "test": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [],
      "inputs": [
        "src/**",
        "bunfig.toml",
        "package.json",
        "tsconfig.json",
        "$TURBO_DEFAULT$"
      ]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "codegen": {
      "cache": false,
      "outputs": ["../api/src/model.ts"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  }
}
