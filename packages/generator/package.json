{
  "name": "@virtbase/proxmox-api-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Generates the API model, endpoint reference and API changelog from the Proxmox VE schema",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "codegen": "bun src/cli.ts generate",
    "codegen:check": "bun src/cli.ts generate --check",
    "codegen:update": "bun src/cli.ts update",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@virtbase/tsconfig": "workspace:*",
    "typescript": "7.0.2"
  }
}
