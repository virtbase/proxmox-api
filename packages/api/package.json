{
  "name": "@virtbase/proxmox-api",
  "version": "6.0.0",
  "description": "Fully typed Proxmox VE API client for TypeScript, generated from the official API schema",
  "keywords": [
    "proxmox",
    "proxmox-ve",
    "pve",
    "api",
    "client",
    "sdk",
    "typescript",
    "virtualization"
  ],
  "homepage": "https://proxmox-api.virtbase.com/",
  "bugs": {
    "url": "https://github.com/virtbase/proxmox-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtbase/proxmox-api.git",
    "directory": "packages/api"
  },
  "license": "MIT",
  "author": "Uriel Chemouni <uchemouni@gmail.com> (https://uriel.ovh/)",
  "contributors": [
    "Janic Bellmann <contact@janic.dev>"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "bun run build",
    "publint": "publint --strict && attw --pack . --profile esm-only",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "1.4.4",
    "@virtbase/tsconfig": "workspace:*",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  }
}
