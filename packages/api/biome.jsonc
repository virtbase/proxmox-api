{
  "root": false,
  "extends": "//",
  "files": {
    // Generated by `bun run codegen` from the upstream PVE API dump: ~600 kB
    // of declarations that no one edits by hand and that the generator would
    // overwrite in its own style on the next run.
    "includes": ["**", "!src/model.ts"]
  },
  // Inherited from upstream, downgraded so the house config can land without a
  // source rewrite in the same pass. Each is a real TODO(fork), not a
  // permanent exemption - re-raise a rule once its sites are cleaned up.
  "linter": {
    "rules": {
      "suspicious": {
        // ~40 sites. The API surface is a `Proxy` that types itself from
        // model.ts; the untyped seams are load-bearing, not sloppiness.
        "noExplicitAny": "off"
      },
      "nursery": {
        // One site: `QmMonitor.deviceAddMissing` fires `deviceAddByPort` in a
        // loop without awaiting. A genuine bug - fixing it means deciding
        // between sequential awaits and `Promise.all`, so it needs its own
        // change.
        "noFloatingPromises": "warn"
      }
    }
  }
}
